# Copy to .env and fill in. .env is git-ignored.
FINANCE_PASSWORD=choose-a-password
SECRET_KEY=at-least-32-random-characters
# optional: FINANCE_PORT=8080  FINANCE_DB=data/finance.db

# optional: Google Calendar sync. Easier: fill these in the app (Settings -> Google Calendar), which overrides .env.
# All three or none. Setup steps: knowledge/systems/system-google-calendar.md
# GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=xxxx
# GOOGLE_REDIRECT_URI=https://your-domain/google/callback
