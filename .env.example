# Copy to .env and fill in. delegate.py reads .env; real env vars take precedence.

# OpenAI (platform.openai.com > API keys). Free daily tokens need data sharing ON.
OPENAI_API_KEY=

# OpenRouter (openrouter.ai > Keys)
OPENROUTER_API_KEY=

# NVIDIA NIM (build.nvidia.com > API keys)
NVIDIA_API_KEY=

# Google AI Studio (aistudio.google.com > Get API key)
GEMINI_API_KEY=
